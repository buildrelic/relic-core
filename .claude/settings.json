{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/ensure_claude_md.py --hook",
            "timeout": 30,
            "statusMessage": "Checking for directories missing CLAUDE.md"
          }
        ]
      }
    ]
  }
}
