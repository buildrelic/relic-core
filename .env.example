# The engram store: Postgres holds the relational memory tables. The schema is
# applied automatically (EngramStore.ensure_schema). The default matches
# `docker compose up -d postgres`; point at a hosted Postgres (e.g. Neon) later.
DATABASE_URL=postgresql://relic:relic@localhost:5432/relic

# The workspace every locally-ingested memory lands in. The web app writes with the
# Clerk scope (orgId ?? userId); the CLI and daemon write here. Leave as "local"
# for a personal checkout.
RELIC_WORKSPACE=local

# Optional. Firestore document mirror -- the same service-account env names the
# landing app uses. When unset, documents stay local-only (memories.body in
# Postgres remains authoritative). FIREBASE_PRIVATE_KEY may keep its literal \n
# escapes; the loader unescapes them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional. Falls back to `gh auth token` when unset.
GITHUB_TOKEN=

# Optional. Enables Linear ingestion when set.
LINEAR_API_KEY=

# Optional. Enables Granola ingestion when set (`relic ingest --source granola`).
GRANOLA_API_KEY=

# Optional. Enables Notion ingestion when set (`relic ingest --source notion`). An internal
# integration token; only pages shared with the integration are visible. Set on its own line,
# no inline comment -- the secret sanitizer rejects values containing whitespace or '#'.
NOTION_API_KEY=

# Optional. Reserved for the Phase 4 skill compiler.
ANTHROPIC_API_KEY=

REGISTRY_DB_PATH=./data/registry.db

# Concurrent GitHub hydration requests during fetch (keep modest to stay under
# API rate limits).
FETCH_CONCURRENCY=10
