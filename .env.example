# OpenAI is required for `relic ingest` and `relic query` (LLM extraction + embeddings).
OPENAI_API_KEY=

# Optional. Falls back to `gh auth token` when unset.
GITHUB_TOKEN=

# Optional. Enables Linear ingestion when set.
LINEAR_API_KEY=

GRAPHITI_LLM_PROVIDER=openai

# FalkorDB connection (self-hosted, e.g. `docker compose up -d falkordb`).
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Optional. Leave unset for a local instance with no auth.
FALKORDB_PASSWORD=
FALKORDB_DATABASE=relic

REGISTRY_DB_PATH=./data/registry.db
SEMAPHORE_LIMIT=10
