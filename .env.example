# OpenAI is required for `relic ingest` and `relic query` (LLM extraction + embeddings).
OPENAI_API_KEY=

# Optional. Falls back to `gh auth token` when unset.
GITHUB_TOKEN=

# Optional. Enables Linear ingestion when set.
LINEAR_API_KEY=

# Optional. Enables Notion ingestion when set (`relic ingest --source notion`). An internal
# integration token; only pages shared with the integration are visible. Set on its own line,
# no inline comment -- the secret sanitizer rejects values containing whitespace or '#'.
NOTION_API_KEY=

# Graph LLM provider: "openai" (default) or "gemini". "gemini" is HYBRID -- Gemini
# Flash handles extraction (its TPM limits are ~20x OpenAI's low tiers, the throughput
# win for a large backfill) while OpenAI keeps doing embeddings + reranking, so it needs
# BOTH keys. Switching providers changes nothing on disk except extraction, but recall
# should run against a graph built by one provider (re-ingest with `--fresh`).
GRAPHITI_LLM_PROVIDER=openai
# Model used when GRAPHITI_LLM_PROVIDER=gemini. Flash-Lite is the fastest/cheapest.
GEMINI_MODEL=gemini-2.5-flash-lite
# Required when GRAPHITI_LLM_PROVIDER=gemini (extraction). Set on its own line, no
# inline comment -- the secret sanitizer rejects values containing whitespace or '#'.
GEMINI_API_KEY=

# FalkorDB connection (self-hosted, e.g. `docker compose up -d falkordb`).
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Optional. Leave unset for a local instance with no auth.
FALKORDB_PASSWORD=
FALKORDB_DATABASE=relic

REGISTRY_DB_PATH=./data/registry.db

# Ingestion concurrency. FETCH_CONCURRENCY bounds concurrent GitHub requests
# (keep modest to stay under API rate limits). GRAPHITI_MAX_COROUTINES bounds
# graphiti's internal LLM concurrency during the load.
#
# Note for the gemini provider: Gemini is fast enough that the default of 20 can
# flood FalkorDB's query queue during --bulk ("ResponseError: Max pending queries
# exceeded"), forcing a slow per-episode fallback. Lowering both to ~5 keeps bulk
# under FalkorDB's cap and is actually FASTER (no fallback). OpenAI doesn't hit this
# because its rate-limiting spreads the queries out.
#
# SEMAPHORE_LIMIT is the deprecated pre-split knob. Leave it unset; it is honored only
# as a fallback for an old .env that sets it but not the two below.
# SEMAPHORE_LIMIT=10
FETCH_CONCURRENCY=10
GRAPHITI_MAX_COROUTINES=20

# Route the load through graphiti add_episode_bulk (faster backfill). Also
# available per-run as `relic ingest --bulk`. BULK_BATCH_SIZE is episodes per
# bulk call; lower it if you hit OpenAI rate limits (smaller token bursts).
BULK_LOAD=false
BULK_BATCH_SIZE=10
